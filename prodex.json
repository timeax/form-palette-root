{
    "version": 5,
    "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
    "output": {
        "dir": "prodex",
        "versioned": true,
        "format": "md"
    },
    "exclude": [
        "node_modules/**",
        "@shadcn/**",
        "**/components/ui/**"
    ],
    "aliases": {
        "@": "./packages/form-palette/src",
        "@inertiajs": ".scaffold",
        "@toast-ui": "packages/form-palette/src/presets/shadcn-variants"
    },
    "depth": 10,
    "maxFiles": 200,
    "scopes": {
        "core": {
            "include": [
                "./packages/form-palette/src/core/**"
            ]
        },
        "core-provider": {
            "entry": [
                "packages/form-palette/src/index.ts"
            ],
            "include": [
                "./packages/form-palette/src/adapters/**"
            ],
            "exclude": [
                "./packages/form-palette/src/presets/**"
            ]
        },
        "variants": {
            "entry": [],
            "include": [
                "./packages/form-palette/src/presets/shadcn-variants/**",
                "./packages/form-palette/src/presets/ui/**"
            ]
        },
        "lister-and-json": {
            "entry": [
                "packages/form-palette/src/extra.ts"
            ],
            "exclude": [
                "./packages/form-palette/src/core/**",
                "./packages/form-palette/src/adapters/**",
                "./packages/form-palette/src/input/**",
                "./packages/form-palette/src/presets/ui/**"
            ]
        },
        "lister": {
            "name": "lister",
            "entry": [],
            "include": [
                "packages/form-palette/src/presets/lister/**"
            ]
        },
        "default": {
            "include": [
                "**/*.d.ts"
            ],
            "name": "combined"
        }
    }
}
